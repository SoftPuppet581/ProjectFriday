# 정적 데모 빌드(npm run build:static, Vercel 배포)용 설정. 아래 값은 모두 공개되어도 되는 값이다 (비밀 키가 아니다)
VITE_STATIC_DATA=1
# Supabase(로그인, 관심 게임, 포럼). publishable 키는 브라우저에 공개되는 키이고, 쓰기 권한은 DB의 RLS 규칙이 막는다 (docs/SUPABASE.md)
# 이 두 줄을 지우면 로그인/글쓰기가 없는 읽기 전용 데모로 돌아간다. service_role(secret) 키는 절대 여기에 넣지 않는다
VITE_SUPABASE_URL=https://xfjlxskslasadvpdnihf.supabase.co
