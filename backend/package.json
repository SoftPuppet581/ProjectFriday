{
  "name": "game-calendar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node scripts/runSql.js db/schema.sql",
    "db:seed": "node scripts/runSql.js db/seed.sql",
    "db:clean-samples": "node scripts/runSql.js db/remove-samples.sql",
    "db:purge-adult": "node scripts/purgeAdult.js",
    "db:featured": "node scripts/applyFeatured.js",
    "import": "node scripts/importRawg.js",
    "news:refresh": "node scripts/refreshNews.js",
    "export:static": "node scripts/exportStatic.js",
    "seed:demo": "node scripts/seedDemo.js",
    "seed:demo:remove": "node scripts/seedDemo.js --remove",
    "stores:enrich": "node scripts/enrichStores.js",
    "stores:clean": "node scripts/cleanStoreUrls.js",
    "details:fill": "node scripts/fillDetails.js",
    "prices:refresh": "node scripts/refreshPrices.js",
    "enrich": "node scripts/enrichStores.js && node scripts/refreshPrices.js",
    "test": "node --test --test-concurrency=1 test/"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "mysql2": "^3.24.6"
  }
}
